# argo_dockerapp/deploy.env
ES_HOST=10.10.0.1        # IP/DNS for Elasticsearch host server
ES_PORT=30920

# ArgoCD-registered destination servers that should run Fluent Bit.
# Add a line here when a new server joins — no new YAML file needed.
FLUENT_BIT_DESTINATIONS=(
  "https://kubernetes.default.svc"   # wherever ArgoCD itself runs
  "https://node-2:6443"              # Pi
)