#!/bin/bash
# argo_dockerapp/deploy.env
# Single source of truth for cluster targets + Elasticsearch location.
# Sourced by deploy.sh. Add a new server by: (1) adding its name to
# K3S_SERVER_NAMES, (2) defining its four <NAME>_* variables below.

# ----------------------------------------------------------------
# Elasticsearch (single host)
# ----------------------------------------------------------------
ES_HOST=10.10.0.1          # Desktop's LAN IP
ES_PORT=30920                    # NodePort from elasticsearch-external Service
ES_HOST_SERVER_NAME=desktop      # which K3S_SERVER_NAMES entry hosts ES+Kibana

# ----------------------------------------------------------------
# Which server ArgoCD itself is installed on. That server's ArgoCD
# destination is always the magic "https://kubernetes.default.svc"
# value, never its own external URL.
# ----------------------------------------------------------------
ARGOCD_HOST_SERVER_NAME=pi

# ----------------------------------------------------------------
# K3s servers. Used for: verify_connection() (multi-server check from a
# laptop/PC), and ArgoCD destination.server values.
# ----------------------------------------------------------------
K3S_SERVER_NAMES=(pi desktop)

# --- pi --- (behind Cloudflare Tunnel, no direct LAN/public reachability)
PI_SSH_HOST="pi5-1"                    # ~/.ssh/config alias, ProxyCommand cloudflared access ssh
PI_LOCAL_PORT=6443                             # local port for this server's SSH tunnel
PI_KUBECONFIG="$HOME/.kube/KUBECONFIG_pi"         # decoded kubeconfig, LOCAL machine only
PI_ARGOCD_DEST="https://ip:6443"   # registered cluster URL (as seen from the ArgoCD host)

# --- desktop --- (same home LAN as pi)
DESKTOP_SSH_HOST="desk-1"              # ~/.ssh/config alias — direct LAN SSH or its own cloudflared, see notes below
DESKTOP_LOCAL_PORT=6444                        # different port than pi's, so both tunnels coexist
DESKTOP_KUBECONFIG="$HOME/.kube/KUBECONFIG_desktop"
DESKTOP_ARGOCD_DEST="https://ip:6443"