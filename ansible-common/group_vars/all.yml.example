---
# Cloudflare Configuration
#cloudflare_api_token : "<Replace with Cloudflare API Token>"
#cloudflare_email     : "<your-email@gmail.com>"
rancher_domain       : "<rancher.example.com>"
admin_email          : "<admin@example.com>"
argocd_domain         : "<argocd.example.com>"

# Logging (playbooks/install/logging.yml + grafana.yml)
kibana_domain        : "<kibana.example.com>"
# alloy      = Alloy (grafana.yml) -> OTel Collector -> Elasticsearch  (recommended: one log tailer)
# fluent-bit = Fluent Bit DaemonSet -> Elasticsearch
# none       = Elasticsearch + Kibana only
log_shipper          : "alloy"

# Jenkins (playbooks/install/jenkins.yml)
# Admin password: min 12 chars, no single quote ('), backslash or newline.
# Generate:  openssl rand -base64 18
jenkins_admin_password : "<CHANGE_ME>"
# Optional — public URL through Cloudflare Tunnel (route → http://localhost:8080)
jenkins_domain       : "jenkins.example.com"

# CBS databases (postgres/mongodb/redis/rabbitmq.yml + cbs-env.yml) - passwords are generated.
# Optional: so the generated cbs-uat.env / cbs-prod.env have no CHANGE_ME left.
# cbs_cors_origins : {uat: "https://cbs-uat.example.com", prod: "https://cbs.example.com"}
# cbs_kyc_base_url : {uat: "https://kyc-uat.example.com", prod: "https://kyc.example.com"}
# cbs_kyc_api_key  : {uat: "<from Go-KYC>", prod: "<from Go-KYC>"}
