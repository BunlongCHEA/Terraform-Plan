# =============================================================
# PostgreSQL — one server; database + user per env are created by postgres.yml
#   address: postgres.{{ cbs_data_namespace }}.svc.cluster.local:5432
# =============================================================
apiVersion: v1
kind: Secret
metadata:
  name: postgres-admin
  namespace: {{ cbs_data_namespace }}
type: Opaque
stringData:
  POSTGRES_PASSWORD: "{{ pw.postgres_admin }}"
---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: {{ cbs_data_namespace }}
  labels: {app.kubernetes.io/name: postgres}
spec:
  selector: {app.kubernetes.io/name: postgres}
  ports:
    - {name: postgres, port: 5432, targetPort: 5432}
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: postgres
  namespace: {{ cbs_data_namespace }}
  labels: {app.kubernetes.io/name: postgres, app.kubernetes.io/part-of: cbs-data}
spec:
  serviceName: postgres
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: postgres}
  template:
    metadata:
      labels: {app.kubernetes.io/name: postgres, app.kubernetes.io/part-of: cbs-data}
    spec:
      nodeSelector: {"{{ cbs_data_node_label }}": "true"}
      terminationGracePeriodSeconds: 60
      containers:
        - name: postgres
          image: {{ cbs_postgres_image }}
          args: ["-c", "max_connections=200", "-c", "shared_buffers=256MB"]
          ports: [{containerPort: 5432, name: postgres}]
          env:
            - name: POSTGRES_PASSWORD
              valueFrom: {secretKeyRef: {name: postgres-admin, key: POSTGRES_PASSWORD}}
            - {name: PGDATA, value: /var/lib/postgresql/data/pgdata}
            - {name: POSTGRES_INITDB_ARGS, value: "--auth-host=scram-sha-256"}
          readinessProbe:
            exec: {command: ["pg_isready", "-U", "postgres"]}
            periodSeconds: 10
          livenessProbe:
            exec: {command: ["pg_isready", "-U", "postgres"]}
            periodSeconds: 20
            failureThreshold: 6
          resources:
            requests: {cpu: 250m, memory: 512Mi}
            limits: {memory: 2Gi}
          volumeMounts:
            - {name: data, mountPath: /var/lib/postgresql/data}
  volumeClaimTemplates:
    - metadata: {name: data}
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: local-path
        resources: {requests: {storage: {{ cbs_postgres_size }}}}
