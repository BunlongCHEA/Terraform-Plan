# =============================================================
# Redis — one server; ACL user per env:  UAT = DB 1, PROD = DB 0
#   address: redis.{{ cbs_data_namespace }}.svc.cluster.local:6379
#   (Redis ACLs cannot restrict DB numbers: separation = DB index + own password)
# =============================================================
apiVersion: v1
kind: Secret
metadata:
  name: redis-admin
  namespace: {{ cbs_data_namespace }}
type: Opaque
stringData:
  REDISCLI_AUTH: "{{ pw.redis_admin }}"
---
apiVersion: v1
kind: Secret
metadata:
  name: redis-conf
  namespace: {{ cbs_data_namespace }}
type: Opaque
stringData:
  redis.conf: |
    dir /data
    appendonly yes
    appendfsync everysec
    save 900 1
    save 300 100
    maxmemory {{ cbs_redis_maxmemory }}
    maxmemory-policy noeviction
    protected-mode no
    requirepass {{ pw.redis_admin }}
{% for e in cbs_envs %}
    user cbs_{{ e }} on >{{ pw['redis_' ~ e] }} ~* &* +@all -flushall -config -shutdown -debug -acl -replicaof -slaveof -module
{% endfor %}
---
apiVersion: v1
kind: Service
metadata:
  name: redis
  namespace: {{ cbs_data_namespace }}
  labels: {app.kubernetes.io/name: redis}
spec:
  selector: {app.kubernetes.io/name: redis}
  ports:
    - {name: redis, port: 6379, targetPort: 6379}
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: redis
  namespace: {{ cbs_data_namespace }}
  labels: {app.kubernetes.io/name: redis, app.kubernetes.io/part-of: cbs-data}
spec:
  serviceName: redis
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: redis}
  template:
    metadata:
      labels: {app.kubernetes.io/name: redis, app.kubernetes.io/part-of: cbs-data}
      annotations:
        # restart Redis when users/passwords change (config is read at start)
        cbs-data/redis-conf-checksum: "{{ ([pw.redis_admin] + (cbs_envs | map('regex_replace', '^', 'redis_') | map('extract', pw) | list)) | join | hash('sha1') }}"
    spec:
      nodeSelector: {"{{ cbs_data_node_label }}": "true"}
      containers:
        - name: redis
          image: {{ cbs_redis_image }}
          command: ["redis-server", "/conf/redis.conf"]
          ports: [{containerPort: 6379, name: redis}]
          envFrom:
            - secretRef: {name: redis-admin}
          readinessProbe:
            exec: {command: ["redis-cli", "ping"]}
            periodSeconds: 10
          livenessProbe:
            exec: {command: ["redis-cli", "ping"]}
            periodSeconds: 20
          resources:
            requests: {cpu: 100m, memory: 128Mi}
            limits: {memory: 768Mi}
          volumeMounts:
            - {name: data, mountPath: /data}
            - {name: conf, mountPath: /conf, readOnly: true}
      volumes:
        - name: conf
          secret: {secretName: redis-conf}
  volumeClaimTemplates:
    - metadata: {name: data}
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: local-path
        resources: {requests: {storage: {{ cbs_redis_size }}}}
