# =============================================================
# cbs-{{ e }}.env — generated by Terraform-Plan playbooks/install/cbs-env.yml
# on {{ ansible_date_time.iso8601 }}. Upload to Jenkins as Secret file, ID: cbs-{{ e }}-env
#
# Generated for you: every password/secret below that is not marked FILL IN.
# Values are stored in ansible-common/access-info/cbs-data/secrets/ (git-ignored);
# re-running keeps them. After rotating a password: ./terraform_main.sh raspberrypi cbs-env
# =============================================================

SPRING_PROFILES_ACTIVE={{ e }}

# ---- PostgreSQL (namespace {{ cbs_data_namespace }}) ----
DB_HOST={{ cbs_hosts.postgres }}
DB_PORT=5432
DB_NAME=core_banking_{{ e }}
DB_USERNAME=cbs_{{ e }}
DB_PASSWORD={{ pw['pg_' ~ e] }}

# ---- MongoDB ----
MONGO_URI=mongodb://cbs_{{ e }}:{{ pw['mongo_' ~ e] }}@{{ cbs_hosts.mongodb }}:27017/cbs_logs_{{ e }}?authSource=cbs_logs_{{ e }}

# ---- Redis ({{ 'DB 0' if e == 'prod' else 'DB 1' }}) ----
REDIS_URI=redis://cbs_{{ e }}:{{ pw['redis_' ~ e] }}@{{ cbs_hosts.redis }}:6379/{{ 0 if e == 'prod' else 1 }}

# ---- Security (generated) ----
JWT_SECRET={{ pw['jwt_' ~ e] }}
CBS_SUPER_ADMIN_INITIAL_PASSWORD={{ pw['superadmin_' ~ e] }}
# FILL IN: the frontend URL(s) allowed to call this API, comma-separated
CBS_CORS_ORIGINS={{ cbs_cors_origins[e] | default('CHANGE_ME_https://your-frontend') }}

# ---- KYC integration ----
# FILL IN: Go-KYC URL and the integration API key it issued for CBS
KYC_BASE_URL={{ cbs_kyc_base_url[e] | default('CHANGE_ME_https://kyc.example.com') }}
KYC_API_KEY={{ cbs_kyc_api_key[e] | default('CHANGE_ME') }}
# Generated. Must be the SAME value on the KYC side (message encryption key, base64 of 32 bytes)
KYC_MQ_KEY_V1={{ pw['kycmq_' ~ e] | b64encode }}
CBS_HMAC_SECRET={{ pw['hmac_' ~ e] }}

# ---- RabbitMQ (vhost cbs_{{ e }}) ----
# Set RABBITMQ_ENABLED=true once Go-KYC publishes to this RabbitMQ / vhost.
RABBITMQ_ENABLED=false
RABBITMQ_HOST={{ cbs_hosts.rabbitmq }}
RABBITMQ_PORT=5672
RABBITMQ_USER=cbs_{{ e }}
RABBITMQ_PASS={{ pw['rabbitmq_' ~ e] }}
RABBITMQ_VHOST=cbs_{{ e }}
RABBITMQ_SSL_ENABLED=false
MANAGEMENT_HEALTH_RABBIT_ENABLED=false
