apiVersion: v1
kind: Config
clusters:
  - name: k3s
    cluster:
      server: {{ kc_server }}
      certificate-authority-data: {{ kc_ca }}
users:
  - name: {{ kc_user }}
    user:
      token: {{ kc_token }}
contexts:
  - name: {{ kc_user }}@k3s
    context:
      cluster: k3s
      user: {{ kc_user }}
      namespace: {{ kc_namespace }}
current-context: {{ kc_user }}@k3s
